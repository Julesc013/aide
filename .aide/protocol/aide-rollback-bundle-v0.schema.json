{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aide.dev/schemas/aide-rollback-bundle-v0.schema.json",
  "title": "AIDE RollbackBundle v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schema_version",
    "metadata",
    "spec",
    "status",
    "extensions"
  ],
  "properties": {
    "apiVersion": {"type": "string", "const": "aide.dev/v1alpha1"},
    "kind": {"type": "string", "const": "RollbackBundle"},
    "schema_version": {"type": "string", "const": "aide.rollback-bundle.v0"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"},
    "status": {"$ref": "#/$defs/status"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "extensions": {"type": "object", "additionalProperties": true},
    "ref": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reverse_operation_class": {
      "type": "string",
      "enum": [
        "restore_managed_file_preimage",
        "restore_managed_section_preimage",
        "remove_added_managed_file",
        "remove_added_managed_section",
        "restore_project_lock",
        "restore_install_record",
        "restore_ownership_ledger",
        "regenerate_project_output",
        "manual_review_required",
        "rollback_unavailable",
        "refuse"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollback_bundle_ref",
        "update_plan_ref",
        "update_plan_digest",
        "target_project_ref",
        "target_project_identity",
        "prior_project_lock_ref",
        "prior_project_lock_digest",
        "candidate_project_lock_ref",
        "candidate_project_lock_digest",
        "prior_ownership_ledger_ref",
        "prior_ownership_ledger_digest",
        "source_distribution_ref",
        "source_distribution_digest",
        "candidate_distribution_ref",
        "candidate_distribution_digest",
        "created_at",
        "created_by",
        "prior_rollback_bundle_ref",
        "superseded_by_ref",
        "extensions"
      ],
      "properties": {
        "rollback_bundle_ref": {"$ref": "#/$defs/ref"},
        "update_plan_ref": {"$ref": "#/$defs/ref"},
        "update_plan_digest": {"$ref": "#/$defs/digest"},
        "target_project_ref": {"$ref": "#/$defs/ref"},
        "target_project_identity": {"type": "string", "minLength": 1},
        "prior_project_lock_ref": {"$ref": "#/$defs/ref"},
        "prior_project_lock_digest": {"$ref": "#/$defs/digest"},
        "candidate_project_lock_ref": {"$ref": "#/$defs/ref"},
        "candidate_project_lock_digest": {"$ref": "#/$defs/digest"},
        "prior_ownership_ledger_ref": {"$ref": "#/$defs/ref"},
        "prior_ownership_ledger_digest": {"$ref": "#/$defs/digest"},
        "source_distribution_ref": {"$ref": "#/$defs/ref"},
        "source_distribution_digest": {"$ref": "#/$defs/digest"},
        "candidate_distribution_ref": {"$ref": "#/$defs/ref"},
        "candidate_distribution_digest": {"$ref": "#/$defs/digest"},
        "created_at": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "prior_rollback_bundle_ref": {"type": ["string", "null"]},
        "superseded_by_ref": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "preimage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "preimage_ref",
        "operation_ref",
        "target_relative_path",
        "ownership_entry_ref",
        "ownership_class",
        "preimage_digest",
        "postimage_digest",
        "artifact_kind",
        "evidence_refs",
        "extensions"
      ],
      "properties": {
        "preimage_ref": {"$ref": "#/$defs/ref"},
        "operation_ref": {"$ref": "#/$defs/ref"},
        "target_relative_path": {"type": "string", "minLength": 1},
        "ownership_entry_ref": {"type": ["string", "null"]},
        "ownership_class": {"type": "string", "minLength": 1},
        "preimage_digest": {"type": "string"},
        "postimage_digest": {"type": "string"},
        "section_identity": {"type": ["string", "null"]},
        "artifact_kind": {"type": "string", "enum": ["managed_file_preimage", "managed_section_preimage"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "reverse_operation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "reverse_operation_ref",
        "source_operation_ref",
        "reverse_operation_class",
        "ownership_class",
        "preimage_artifact_ref",
        "preimage_digest",
        "postimage_digest",
        "manual_review_required",
        "rollback_apply_implemented",
        "target_repository_mutation_performed",
        "source_output_used_as_target_truth",
        "evidence_refs",
        "extensions"
      ],
      "properties": {
        "reverse_operation_ref": {"$ref": "#/$defs/ref"},
        "source_operation_ref": {"$ref": "#/$defs/ref"},
        "reverse_operation_class": {"$ref": "#/$defs/reverse_operation_class"},
        "target_relative_path": {"type": ["string", "null"]},
        "ownership_entry_ref": {"type": ["string", "null"]},
        "ownership_class": {"type": "string", "minLength": 1},
        "preimage_artifact_ref": {"type": ["string", "null"]},
        "preimage_digest": {"type": "string"},
        "postimage_digest": {"type": "string"},
        "manual_review_required": {"type": "boolean"},
        "rollback_apply_implemented": {"type": "boolean", "const": false},
        "target_repository_mutation_performed": {"type": "boolean", "const": false},
        "source_output_used_as_target_truth": {"type": "boolean", "const": false},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_install_record_refs",
        "prior_install_record_digests",
        "preimage_artifact_refs",
        "managed_file_preimages",
        "managed_section_preimages",
        "reverse_operations",
        "operation_rollback_map",
        "validation_plan",
        "integrity_checks",
        "manual_review_items",
        "limitations",
        "risk_class",
        "evidence_refs",
        "explicit_non_capabilities",
        "required_features",
        "optional_features",
        "source_output_used_as_target_truth",
        "target_repository_mutation_performed",
        "extensions"
      ],
      "properties": {
        "prior_install_record_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prior_install_record_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "preimage_artifact_refs": {"type": "array", "items": {"type": "string"}},
        "managed_file_preimages": {"type": "array", "items": {"$ref": "#/$defs/preimage"}},
        "managed_section_preimages": {"type": "array", "items": {"$ref": "#/$defs/preimage"}},
        "reverse_operations": {"type": "array", "items": {"$ref": "#/$defs/reverse_operation"}},
        "operation_rollback_map": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "integrity_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "manual_review_items": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "risk_class": {"type": "string", "enum": ["low", "medium", "high", "blocked"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "explicit_non_capabilities": {"type": "array", "items": {"type": "string"}},
        "required_features": {"type": "array", "items": {"type": "string"}},
        "optional_features": {"type": "array", "items": {"type": "string"}},
        "source_output_used_as_target_truth": {"type": "boolean", "const": false},
        "target_repository_mutation_performed": {"type": "boolean", "const": false},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "validation_result",
        "proposed_capability",
        "recommended_next_task",
        "rollback_bundle_digest",
        "rollback_apply_implemented",
        "target_repository_mutation_implemented",
        "extensions"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION"]},
        "validation_result": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION"]},
        "proposed_capability": {"type": "string", "const": "rollback_bundle_v0"},
        "recommended_next_task": {"type": "string", "const": "AIDE-CHECK-ROLLBACK-BUNDLE-V0-01"},
        "rollback_bundle_digest": {"$ref": "#/$defs/digest"},
        "install_apply_implemented": {"type": "boolean", "const": false},
        "update_apply_implemented": {"type": "boolean", "const": false},
        "migration_apply_implemented": {"type": "boolean", "const": false},
        "repair_apply_implemented": {"type": "boolean", "const": false},
        "rollback_apply_implemented": {"type": "boolean", "const": false},
        "uninstall_apply_implemented": {"type": "boolean", "const": false},
        "target_repository_mutation_implemented": {"type": "boolean", "const": false},
        "target_scan_authority_implemented": {"type": "boolean", "const": false},
        "release_publication_implemented": {"type": "boolean", "const": false},
        "network_calls_implemented": {"type": "boolean", "const": false},
        "provider_model_calls_implemented": {"type": "boolean", "const": false},
        "workbench_runtime_implemented": {"type": "boolean", "const": false},
        "commander_implemented": {"type": "boolean", "const": false},
        "omnigent_implemented": {"type": "boolean", "const": false},
        "branch_worktree_automation_implemented": {"type": "boolean", "const": false},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    }
  }
}
