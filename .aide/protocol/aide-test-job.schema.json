{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Minimal AIDE TestJob schema for additive metadata-only projections from accepted validation, check, and test artifacts.",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "TestJob"
      ],
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "properties": {
        "compatibility": {
          "additionalProperties": true,
          "properties": {
            "featureFlags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "minReaderVersion": {
              "type": "string"
            },
            "minWriterVersion": {
              "type": "string"
            },
            "protocolVersion": {
              "type": "string"
            },
            "requiredCapabilities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "schemaVersion": {
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "protocolVersion",
            "minReaderVersion",
            "minWriterVersion",
            "featureFlags"
          ],
          "type": "object"
        },
        "createdAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "producer": {
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "type": "object"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "createdAt",
        "sourcePath",
        "producer",
        "compatibility"
      ],
      "type": "object"
    },
    "protocol_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "spec": {
      "additionalProperties": true,
      "properties": {
        "artifacts": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "content_type": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "role"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "capability_label": {
          "type": "string"
        },
        "command": {
          "additionalProperties": true,
          "properties": {
            "argv": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "cwd": {
              "type": "string"
            },
            "env_policy": {
              "type": "string"
            },
            "shell": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "argv",
            "cwd",
            "env_policy",
            "shell"
          ],
          "type": "object"
        },
        "environment": {
          "additionalProperties": true,
          "properties": {
            "notes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "platform": {
              "type": [
                "string",
                "null"
              ]
            },
            "python": {
              "type": [
                "string",
                "null"
              ]
            },
            "runner_kind": {
              "enum": [
                "metadata_only",
                "local_script",
                "ci",
                "human",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "runner_kind",
            "platform",
            "python",
            "notes"
          ],
          "type": "object"
        },
        "evidence_packet_refs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        "explicit_non_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "failure_summary": {
          "additionalProperties": true,
          "properties": {
            "excerpt_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "failed_tests": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "likely_files": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "parser_status": {
              "enum": [
                "metadata_only",
                "not_implemented",
                "parsed",
                "unknown"
              ],
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "summary",
            "failed_tests",
            "likely_files",
            "excerpt_path",
            "parser_status"
          ],
          "type": "object"
        },
        "framework": {
          "additionalProperties": true,
          "properties": {
            "name": {
              "enum": [
                "unittest",
                "pytest",
                "junit",
                "tap",
                "custom",
                "unknown",
                "none"
              ],
              "type": "string"
            },
            "parser_status": {
              "enum": [
                "metadata_only",
                "not_implemented",
                "parsed",
                "unknown"
              ],
              "type": "string"
            },
            "result_format": {
              "enum": [
                "text",
                "json",
                "junit_xml",
                "tap",
                "markdown",
                "none",
                "unknown"
              ],
              "type": "string"
            }
          },
          "required": [
            "name",
            "result_format",
            "parser_status"
          ],
          "type": "object"
        },
        "job_id": {
          "type": "string"
        },
        "job_kind": {
          "enum": [
            "metadata_only",
            "validation_observation",
            "unit_test",
            "integration_test",
            "lint",
            "typecheck",
            "schema_validate",
            "command_check",
            "unknown"
          ],
          "type": "string"
        },
        "logs": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "path": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "role"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "retry": {
          "additionalProperties": true,
          "properties": {
            "attempt": {
              "type": "integer"
            },
            "flake_classification": {
              "type": "string"
            },
            "max_attempts": {
              "type": "integer"
            },
            "retry_policy": {
              "type": "string"
            }
          },
          "required": [
            "attempt",
            "max_attempts",
            "retry_policy",
            "flake_classification"
          ],
          "type": "object"
        },
        "source_task_id": {
          "type": "string"
        },
        "source_worker_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_workunit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "additionalProperties": true,
          "properties": {
            "timed_out": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "timeout_policy": {
              "enum": [
                "metadata_only",
                "not_configured",
                "planned",
                "unknown"
              ],
              "type": "string"
            },
            "timeout_seconds": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "timeout_seconds",
            "timeout_policy",
            "timed_out"
          ],
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "source_task_id",
        "source_workunit_id",
        "source_worker_run_id",
        "job_kind",
        "command",
        "environment",
        "framework",
        "timeout",
        "artifacts",
        "logs",
        "evidence_packet_refs",
        "explicit_non_capabilities"
      ],
      "type": "object"
    },
    "status": {
      "additionalProperties": true,
      "properties": {
        "durationSeconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "enum": [
            "planned",
            "metadata_only",
            "validation_observation",
            "submitted",
            "running",
            "completed",
            "failed",
            "blocked",
            "cancelled",
            "timed_out",
            "unknown"
          ],
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNINGS",
            "FAILED_VALIDATION",
            "BLOCKED",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_RUN",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "validated": {
          "type": "boolean"
        },
        "validation_errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "validation_warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "phase",
        "result",
        "validated",
        "validation_errors",
        "validation_warnings"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "status"
  ],
  "title": "AIDE Minimal TestJob",
  "type": "object"
}
