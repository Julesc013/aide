{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Minimal AIDE ConformanceProfile schema for profile-scoped admission requirements. This schema defines required, optional, and advisory conformance cases but does not record observed results or admit capabilities.",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "ConformanceProfile"
      ],
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "properties": {
        "compatibility": {
          "additionalProperties": true,
          "properties": {
            "featureFlags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "minReaderVersion": {
              "type": "string"
            },
            "minWriterVersion": {
              "type": "string"
            },
            "protocolVersion": {
              "type": "string"
            },
            "requiredCapabilities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "schemaVersion": {
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "protocolVersion",
            "minReaderVersion",
            "minWriterVersion",
            "featureFlags"
          ],
          "type": "object"
        },
        "createdAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "producer": {
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "type": "object"
        },
        "sourcePath": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "createdAt",
        "sourcePath",
        "producer",
        "compatibility"
      ],
      "type": "object"
    },
    "protocol_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "spec": {
      "additionalProperties": true,
      "properties": {
        "accepted_predecessor": {
          "type": "string"
        },
        "aggregation_policy": {
          "additionalProperties": true,
          "type": "object"
        },
        "cases": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "accepted_outcomes": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "case_id": {
                "type": "string"
              },
              "case_ref": {
                "type": "string"
              },
              "dependencies": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "description": {
                "type": "string"
              },
              "evaluator": {
                "type": "string"
              },
              "evidence_required": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "requirement_level": {
                "enum": [
                  "required",
                  "optional",
                  "advisory"
                ],
                "type": "string"
              },
              "result_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_refs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "case_id",
              "case_ref",
              "title",
              "requirement_level",
              "evaluator",
              "accepted_outcomes",
              "evidence_required",
              "dependencies",
              "source_refs",
              "result_ref"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "evidence_requirements": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "explicit_non_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lifecycle": {
          "enum": [
            "candidate",
            "accepted",
            "superseded"
          ],
          "type": "string"
        },
        "profile_class": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_ref": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "subject": {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "type": "object"
        }
      },
      "required": [
        "profile_ref",
        "profile_id",
        "profile_version",
        "lifecycle",
        "subject",
        "profile_class",
        "cases",
        "aggregation_policy",
        "evidence_requirements",
        "explicit_non_capabilities"
      ],
      "type": "object"
    },
    "status": {
      "additionalProperties": true,
      "properties": {
        "admission_performed": {
          "type": "boolean"
        },
        "admitted": {
          "type": "boolean"
        },
        "execution_implemented": {
          "type": "boolean"
        },
        "profile_only": {
          "type": "boolean"
        },
        "result_generated": {
          "type": "boolean"
        },
        "trusted": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "validation_errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "validation_status": {
          "type": "string"
        },
        "validation_warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "valid",
        "validation_status",
        "validation_errors",
        "validation_warnings",
        "profile_only",
        "result_generated",
        "execution_implemented",
        "admission_performed",
        "admitted",
        "trusted"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "status"
  ],
  "title": "AIDE Minimal ConformanceProfile",
  "type": "object"
}
