{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aide.dev/schemas/aide-update-receipt-v0.schema.json",
  "title": "AIDE UpdateReceipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schema_version",
    "metadata",
    "spec",
    "status",
    "extensions"
  ],
  "properties": {
    "apiVersion": {"type": "string", "const": "aide.dev/v1alpha1"},
    "kind": {"type": "string", "const": "UpdateReceipt"},
    "schema_version": {"type": "string", "const": "aide.update-receipt.v0"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"},
    "status": {"$ref": "#/$defs/status"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "extensions": {"type": "object", "additionalProperties": true},
    "ref": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation_receipt_class": {
      "type": "string",
      "enum": [
        "managed_file_added",
        "managed_file_updated",
        "managed_file_removed",
        "managed_section_added",
        "managed_section_updated",
        "managed_section_removed",
        "project_owned_preserved",
        "project_overlay_preserved",
        "local_only_preserved",
        "runtime_generated_preserved",
        "evidence_only_preserved",
        "legacy_preserved",
        "never_touch_preserved",
        "migration_recorded",
        "lock_updated",
        "ownership_ledger_updated",
        "install_record_updated",
        "validation_run",
        "validation_skipped",
        "manual_review_recorded",
        "operation_refused",
        "operation_failed",
        "rollback_bundle_referenced"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_receipt_ref",
        "update_plan_ref",
        "update_plan_digest",
        "rollback_bundle_ref",
        "rollback_bundle_digest",
        "target_project_ref",
        "target_project_identity",
        "old_project_lock_ref",
        "old_project_lock_digest",
        "new_project_lock_ref",
        "new_project_lock_digest",
        "prior_ownership_ledger_ref",
        "prior_ownership_ledger_digest",
        "new_ownership_ledger_ref",
        "new_ownership_ledger_digest",
        "source_distribution_ref",
        "source_distribution_digest",
        "candidate_distribution_ref",
        "candidate_distribution_digest",
        "created_at",
        "created_by",
        "prior_update_receipt_ref",
        "superseded_by_ref",
        "extensions"
      ],
      "properties": {
        "update_receipt_ref": {"$ref": "#/$defs/ref"},
        "update_plan_ref": {"$ref": "#/$defs/ref"},
        "update_plan_digest": {"$ref": "#/$defs/digest"},
        "rollback_bundle_ref": {"$ref": "#/$defs/ref"},
        "rollback_bundle_digest": {"$ref": "#/$defs/digest"},
        "target_project_ref": {"$ref": "#/$defs/ref"},
        "target_project_identity": {"type": "string", "minLength": 1},
        "old_project_lock_ref": {"$ref": "#/$defs/ref"},
        "old_project_lock_digest": {"$ref": "#/$defs/digest"},
        "new_project_lock_ref": {"$ref": "#/$defs/ref"},
        "new_project_lock_digest": {"$ref": "#/$defs/digest"},
        "prior_ownership_ledger_ref": {"$ref": "#/$defs/ref"},
        "prior_ownership_ledger_digest": {"$ref": "#/$defs/digest"},
        "new_ownership_ledger_ref": {"$ref": "#/$defs/ref"},
        "new_ownership_ledger_digest": {"$ref": "#/$defs/digest"},
        "source_distribution_ref": {"$ref": "#/$defs/ref"},
        "source_distribution_digest": {"$ref": "#/$defs/digest"},
        "candidate_distribution_ref": {"$ref": "#/$defs/ref"},
        "candidate_distribution_digest": {"$ref": "#/$defs/digest"},
        "created_at": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "prior_update_receipt_ref": {"type": ["string", "null"]},
        "superseded_by_ref": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "operation_receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "operation_receipt_ref",
        "operation_ref",
        "operation_receipt_class",
        "operation_class",
        "target_relative_path",
        "ownership_entry_ref",
        "ownership_class",
        "preimage_digest",
        "postimage_digest",
        "changed_artifact_ref",
        "validation_result_ref",
        "approval_ref",
        "update_apply_implemented",
        "target_repository_mutation_performed",
        "authorization_claimed",
        "source_output_used_as_target_truth",
        "evidence_refs",
        "extensions"
      ],
      "properties": {
        "operation_receipt_ref": {"$ref": "#/$defs/ref"},
        "operation_ref": {"$ref": "#/$defs/ref"},
        "operation_receipt_class": {"$ref": "#/$defs/operation_receipt_class"},
        "operation_class": {"type": "string", "minLength": 1},
        "target_relative_path": {"type": ["string", "null"]},
        "ownership_entry_ref": {"type": ["string", "null"]},
        "ownership_class": {"type": "string", "minLength": 1},
        "preimage_digest": {"type": "string"},
        "postimage_digest": {"type": "string"},
        "changed_artifact_ref": {"type": ["string", "null"]},
        "validation_result_ref": {"type": ["string", "null"]},
        "approval_ref": {"type": ["string", "null"]},
        "update_apply_implemented": {"type": "boolean", "const": false},
        "target_repository_mutation_performed": {"type": "boolean", "const": false},
        "authorization_claimed": {"type": "boolean", "const": false},
        "source_output_used_as_target_truth": {"type": "boolean", "const": false},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "changed_artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "operation_ref",
        "target_relative_path",
        "artifact_ref",
        "evidence_refs",
        "extensions"
      ],
      "properties": {
        "operation_ref": {"$ref": "#/$defs/ref"},
        "target_relative_path": {"type": ["string", "null"]},
        "artifact_ref": {"$ref": "#/$defs/ref"},
        "preimage_digest": {"type": "string"},
        "postimage_digest": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "validation_result_ref",
        "result",
        "update_apply_implemented",
        "target_repository_mutation_performed",
        "evidence_refs",
        "extensions"
      ],
      "properties": {
        "validation_result_ref": {"$ref": "#/$defs/ref"},
        "result": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION", "SKIPPED"]},
        "update_apply_implemented": {"type": "boolean", "const": false},
        "target_repository_mutation_performed": {"type": "boolean", "const": false},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_install_record_refs",
        "prior_install_record_digests",
        "new_install_record_ref",
        "operation_receipts",
        "skipped_operations",
        "failed_operations",
        "changed_file_refs",
        "changed_section_refs",
        "preimage_digests",
        "postimage_digests",
        "artifact_refs",
        "validation_results",
        "approval_ref",
        "executor_ref",
        "execution_environment",
        "warnings",
        "limitations",
        "risk_class",
        "evidence_refs",
        "explicit_non_capabilities",
        "required_features",
        "optional_features",
        "source_output_used_as_target_truth",
        "target_repository_mutation_performed",
        "extensions"
      ],
      "properties": {
        "prior_install_record_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prior_install_record_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "new_install_record_ref": {"$ref": "#/$defs/ref"},
        "operation_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation_receipt"}},
        "skipped_operations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "failed_operations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "changed_file_refs": {"type": "array", "items": {"$ref": "#/$defs/changed_artifact"}},
        "changed_section_refs": {"type": "array", "items": {"$ref": "#/$defs/changed_artifact"}},
        "preimage_digests": {"type": "object", "additionalProperties": {"type": "string"}},
        "postimage_digests": {"type": "object", "additionalProperties": {"type": "string"}},
        "artifact_refs": {"type": "array", "items": {"type": "string"}},
        "validation_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation_result"}},
        "approval_ref": {"$ref": "#/$defs/ref"},
        "executor_ref": {"$ref": "#/$defs/ref"},
        "execution_environment": {"type": "object", "additionalProperties": true},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "risk_class": {"type": "string", "enum": ["low", "medium", "high", "blocked"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "explicit_non_capabilities": {"type": "array", "items": {"type": "string"}},
        "required_features": {"type": "array", "items": {"type": "string"}},
        "optional_features": {"type": "array", "items": {"type": "string"}},
        "source_output_used_as_target_truth": {"type": "boolean", "const": false},
        "target_repository_mutation_performed": {"type": "boolean", "const": false},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "validation_result",
        "proposed_capability",
        "recommended_next_task",
        "update_receipt_digest",
        "receipt_authorization_claimed",
        "install_apply_implemented",
        "update_apply_implemented",
        "migration_apply_implemented",
        "rollback_apply_implemented",
        "uninstall_apply_implemented",
        "target_repository_mutation_implemented",
        "target_scan_authority_implemented",
        "release_publication_implemented",
        "release_readiness_claimed",
        "network_calls_implemented",
        "provider_model_calls_implemented",
        "distribution_apply_engine_started",
        "extensions"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION"]},
        "validation_result": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION"]},
        "proposed_capability": {"type": "string", "const": "update_receipt_v0"},
        "recommended_next_task": {"type": "string", "const": "AIDE-CHECK-UPDATE-RECEIPT-V0-01"},
        "update_receipt_digest": {"$ref": "#/$defs/digest"},
        "receipt_authorization_claimed": {"type": "boolean", "const": false},
        "install_apply_implemented": {"type": "boolean", "const": false},
        "update_apply_implemented": {"type": "boolean", "const": false},
        "migration_apply_implemented": {"type": "boolean", "const": false},
        "repair_apply_implemented": {"type": "boolean", "const": false},
        "rollback_apply_implemented": {"type": "boolean", "const": false},
        "uninstall_apply_implemented": {"type": "boolean", "const": false},
        "target_repository_mutation_implemented": {"type": "boolean", "const": false},
        "target_scan_authority_implemented": {"type": "boolean", "const": false},
        "release_publication_implemented": {"type": "boolean", "const": false},
        "release_readiness_claimed": {"type": "boolean", "const": false},
        "network_calls_implemented": {"type": "boolean", "const": false},
        "provider_model_calls_implemented": {"type": "boolean", "const": false},
        "distribution_apply_engine_started": {"type": "boolean", "const": false},
        "workbench_runtime_implemented": {"type": "boolean", "const": false},
        "commander_implemented": {"type": "boolean", "const": false},
        "omnigent_implemented": {"type": "boolean", "const": false},
        "branch_worktree_automation_implemented": {"type": "boolean", "const": false},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    }
  }
}
