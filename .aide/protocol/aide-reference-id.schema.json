{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Minimal AIDE ReferenceID schema for stable aide:// identities with optional file locators and content hashes.",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "ReferenceID"
      ],
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "properties": {
        "compatibility": {
          "additionalProperties": true,
          "properties": {
            "featureFlags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "minReaderVersion": {
              "type": "string"
            },
            "minWriterVersion": {
              "type": "string"
            },
            "protocolVersion": {
              "type": "string"
            },
            "requiredCapabilities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "schemaVersion": {
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "protocolVersion",
            "minReaderVersion",
            "minWriterVersion",
            "featureFlags"
          ],
          "type": "object"
        },
        "createdAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "producer": {
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "type": "object"
        },
        "sourcePath": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "createdAt",
        "sourcePath",
        "producer",
        "compatibility"
      ],
      "type": "object"
    },
    "protocol_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "spec": {
      "additionalProperties": true,
      "properties": {
        "capability_label": {
          "type": "string"
        },
        "explicit_non_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "file_paths_are_locators": {
          "type": "boolean"
        },
        "identity": {
          "additionalProperties": true,
          "properties": {
            "fragment": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "id",
            "fragment"
          ],
          "type": "object"
        },
        "locator": {
          "additionalProperties": true,
          "properties": {
            "media_type": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ref": {
          "type": "string"
        },
        "ref_kind": {
          "type": "string"
        },
        "relationship": {
          "enum": [
            "identifies",
            "references",
            "projects",
            "describes",
            "future_placeholder"
          ],
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "source_status": {
          "type": "string"
        },
        "stable_identity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "ref_kind",
        "identity",
        "locator",
        "required",
        "relationship",
        "explicit_non_capabilities"
      ],
      "type": "object"
    },
    "status": {
      "additionalProperties": true,
      "properties": {
        "phase": {
          "type": "string"
        },
        "resolution": {
          "enum": [
            "syntactic_only",
            "locator_present",
            "locator_missing",
            "not_resolved"
          ],
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNINGS",
            "FAILED_VALIDATION",
            "BLOCKED",
            "PARTIAL",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "valid": {
          "type": "boolean"
        },
        "validated": {
          "type": "boolean"
        },
        "validation_errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "validation_warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "valid",
        "resolution",
        "validation_errors",
        "validation_warnings"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "status"
  ],
  "title": "AIDE Minimal ReferenceID",
  "type": "object"
}
