{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Projection-only RevocationRecord record for AIDE trust and authorization contract v0.",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "const": "RevocationRecord",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "properties": {
        "compatibility": {
          "type": "object"
        },
        "createdAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "producer": {
          "type": "object"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "createdAt",
        "sourcePath",
        "producer",
        "compatibility"
      ],
      "type": "object"
    },
    "protocol_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "spec": {
      "additionalProperties": true,
      "required": [
        "revocation_ref",
        "subject_ref",
        "subject_kind",
        "reason_code",
        "authority_ref",
        "effective_at",
        "affected_grants",
        "affected_admissions",
        "affected_delegations",
        "superseding_refs",
        "evidence_refs"
      ],
      "type": "object"
    },
    "status": {
      "additionalProperties": true,
      "properties": {
        "projection_only": {
          "type": "boolean"
        },
        "validated": {
          "type": "boolean"
        },
        "validation_errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "validation_warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "validated",
        "projection_only",
        "validation_errors",
        "validation_warnings"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "status"
  ],
  "title": "AIDE RevocationRecord schema",
  "type": "object"
}
