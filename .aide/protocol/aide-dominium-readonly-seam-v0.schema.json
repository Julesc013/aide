{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArtifactReferenceRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "ArtifactReference"
        },
        "spec": {
          "$ref": "#/$defs/ArtifactReferenceSpec"
        }
      }
    },
    "ArtifactReferenceSpec": {
      "additionalProperties": true,
      "required": [
        "artifact_ref",
        "source_path",
        "source_role",
        "authority",
        "sha256",
        "size_bytes",
        "git_object",
        "source_revision",
        "identity_is_file_path",
        "file_path_is_locator"
      ],
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": true,
      "properties": {
        "readOldWriteCurrent": {
          "const": true
        },
        "requiredCapabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "protocolVersion",
        "minReaderVersion",
        "minWriterVersion",
        "featureFlags",
        "requiredCapabilities",
        "readOldWriteCurrent",
        "unknownOptionalFields",
        "unknownRequiredFields"
      ],
      "type": "object"
    },
    "ContextDescriptorRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "ContextDescriptor"
        },
        "spec": {
          "$ref": "#/$defs/ContextDescriptorSpec"
        }
      }
    },
    "ContextDescriptorSpec": {
      "additionalProperties": true,
      "required": [
        "context_ref",
        "artifact_refs",
        "section_count",
        "sections",
        "source_revision_binding",
        "projection_direction"
      ],
      "type": "object"
    },
    "DiagnosticProjectionRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "DiagnosticProjection"
        },
        "spec": {
          "$ref": "#/$defs/DiagnosticProjectionSpec"
        }
      }
    },
    "DiagnosticProjectionSpec": {
      "additionalProperties": true,
      "required": [
        "diagnostic_id",
        "code",
        "owner",
        "severity",
        "category",
        "summary",
        "source_registry",
        "native_meaning_owned_by",
        "projection_direction"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "DominiumBridgeManifestRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "DominiumBridgeManifest"
        },
        "spec": {
          "$ref": "#/$defs/DominiumBridgeManifestSpec"
        }
      }
    },
    "DominiumBridgeManifestSpec": {
      "additionalProperties": true,
      "required": [
        "bridge_id",
        "bridge_runtime_implemented",
        "mapping_version",
        "source_of_truth",
        "ownership",
        "command_mapping",
        "compatibility_policy"
      ],
      "type": "object"
    },
    "EventEnvelopeRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "EventEnvelope"
        },
        "spec": {
          "$ref": "#/$defs/EventEnvelopeSpec"
        }
      }
    },
    "EventEnvelopeSpec": {
      "additionalProperties": true,
      "required": [
        "event_ref",
        "event_type",
        "summary",
        "sequence",
        "causation_ref",
        "correlation_ref",
        "universal_event_store_implemented"
      ],
      "type": "object"
    },
    "EvidenceReferenceSetRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "EvidenceReferenceSet"
        },
        "spec": {
          "$ref": "#/$defs/EvidenceReferenceSetSpec"
        }
      }
    },
    "EvidenceReferenceSetSpec": {
      "additionalProperties": true,
      "required": [
        "evidence_refs",
        "evidence_count",
        "native_evidence_meaning_owned_by",
        "aide_behavior"
      ],
      "type": "object"
    },
    "FalseStatus": {
      "additionalProperties": true,
      "properties": {
        "branch_or_worktree_created": {
          "const": false
        },
        "bridge_runtime_started": {
          "const": false
        },
        "database_opened": {
          "const": false
        },
        "dominium_command_invoked": {
          "const": false
        },
        "generated_projection_marked_canonical": {
          "const": false
        },
        "github_mutation_performed": {
          "const": false
        },
        "host_runtime_started": {
          "const": false
        },
        "network_call_performed": {
          "const": false
        },
        "patch_transaction_applied": {
          "const": false
        },
        "preview_or_apply_performed": {
          "const": false
        },
        "provider_or_model_called": {
          "const": false
        },
        "release_or_promotion_performed": {
          "const": false
        },
        "service_started": {
          "const": false
        },
        "source_repository_mutated": {
          "const": false
        },
        "target_repository_mutated": {
          "const": false
        },
        "transport_started": {
          "const": false
        },
        "worker_executed": {
          "const": false
        },
        "workbench_started": {
          "const": false
        }
      },
      "required": [
        "dominium_command_invoked",
        "host_runtime_started",
        "workbench_started",
        "bridge_runtime_started",
        "service_started",
        "database_opened",
        "transport_started",
        "network_call_performed",
        "provider_or_model_called",
        "worker_executed",
        "patch_transaction_applied",
        "preview_or_apply_performed",
        "target_repository_mutated",
        "branch_or_worktree_created",
        "github_mutation_performed",
        "release_or_promotion_performed"
      ],
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": true,
      "required": [
        "branch",
        "worktree_status",
        "local_head",
        "selected_revision",
        "fetch_performed",
        "pull_performed",
        "checkout_performed"
      ],
      "type": "object"
    },
    "HostCapabilitySetRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "HostCapabilitySet"
        },
        "spec": {
          "$ref": "#/$defs/HostCapabilitySetSpec"
        }
      }
    },
    "HostCapabilitySetSpec": {
      "additionalProperties": true,
      "required": [
        "capabilities",
        "forbidden_capabilities"
      ],
      "type": "object"
    },
    "HostManifestRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "HostManifest"
        },
        "spec": {
          "$ref": "#/$defs/HostManifestSpec"
        }
      }
    },
    "HostManifestSpec": {
      "additionalProperties": true,
      "required": [
        "host_id",
        "host_kind",
        "repository_identity",
        "selected_revision",
        "supported_surfaces",
        "registered_dominium_command_count",
        "registered_validation_command_present",
        "runtime_dispatch_available"
      ],
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": true,
      "properties": {
        "authority_role": {
          "type": "string"
        },
        "compatibility": {
          "$ref": "#/$defs/Compatibility"
        },
        "explicit_non_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "id": {
          "type": "string"
        },
        "identity_owner": {
          "enum": [
            "AIDE"
          ]
        },
        "producer": {
          "additionalProperties": true,
          "required": [
            "name",
            "version"
          ],
          "type": "object"
        },
        "protocol_version": {
          "type": "string"
        },
        "schema_version": {
          "const": "aide.dominium-readonly-seam.v0"
        },
        "semantic_owner": {
          "enum": [
            "AIDE",
            "Dominium"
          ]
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "schema_version",
        "protocol_version",
        "producer",
        "source_revision",
        "authority_role",
        "identity_owner",
        "semantic_owner",
        "freshness",
        "compatibility",
        "explicit_non_capabilities"
      ],
      "type": "object"
    },
    "Record": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "const": "aide.dev/v1alpha1"
        },
        "kind": {
          "enum": [
            "HostManifest",
            "HostCapabilitySet",
            "WorkspaceDescriptor",
            "ContextDescriptor",
            "ArtifactReference",
            "DiagnosticProjection",
            "RefusalProjection",
            "EvidenceReferenceSet",
            "EventEnvelope",
            "DominiumBridgeManifest"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/FalseStatus"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec",
        "status"
      ],
      "type": "object"
    },
    "ReferenceID": {
      "pattern": "^aide://[A-Za-z0-9._~-]+/[A-Za-z0-9._~@+=:,-]+$",
      "type": "string"
    },
    "RefusalProjectionRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "RefusalProjection"
        },
        "spec": {
          "$ref": "#/$defs/RefusalProjectionSpec"
        }
      }
    },
    "RefusalProjectionSpec": {
      "additionalProperties": true,
      "required": [
        "refusal_id",
        "code",
        "owner",
        "category",
        "summary",
        "reason",
        "recovery_action",
        "diagnostic_codes",
        "related_commands",
        "source_registry",
        "native_meaning_owned_by",
        "projection_direction"
      ],
      "type": "object"
    },
    "RegistrySummary": {
      "additionalProperties": true,
      "properties": {
        "source_registry_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "source_registry_git_object": {
          "type": "object"
        }
      },
      "required": [
        "path",
        "source_registry_sha256",
        "source_registry_git_object",
        "source_revision",
        "native_count",
        "projected_count",
        "omitted_count",
        "selection_policy",
        "selection_limit",
        "projected_ids",
        "selected_ids_sha256",
        "omitted_ids_sha256",
        "truncation_disclosed"
      ],
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": true,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ReferenceID"
        },
        "authority": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "path",
        "role",
        "authority",
        "required",
        "sha256",
        "artifact_ref"
      ],
      "type": "object"
    },
    "WorkspaceDescriptorRecord": {
      "$ref": "#/$defs/Record",
      "properties": {
        "kind": {
          "const": "WorkspaceDescriptor"
        },
        "spec": {
          "$ref": "#/$defs/WorkspaceDescriptorSpec"
        }
      }
    },
    "WorkspaceDescriptorSpec": {
      "additionalProperties": true,
      "required": [
        "workspace_ref",
        "repository_remote_url_hash",
        "selected_revision",
        "branch",
        "identity_is_file_path",
        "local_path_is_locator_only",
        "queue_status"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Offline read-only AIDE-Dominium seam v0 projection bundle. The bundle records deterministic snapshots, mappings, and validation evidence only; it does not invoke Dominium commands, start services, call providers, execute workers, or mutate repositories.",
  "properties": {
    "apiVersion": {
      "const": "aide.dev/v1alpha1"
    },
    "authority_classification": {
      "additionalProperties": true,
      "required": [
        "canonical_authority",
        "projection_only",
        "conflict_policy"
      ],
      "type": "object"
    },
    "content_digests": {
      "additionalProperties": true,
      "required": [
        "source_snapshot",
        "projection_index",
        "records",
        "seam_bundle_without_self_digest"
      ],
      "type": "object"
    },
    "cross_reference_index": {
      "additionalProperties": true,
      "required": [
        "bundle_ref",
        "workspace_ref",
        "context_ref",
        "artifact_refs",
        "event_refs",
        "diagnostic_ids",
        "refusal_ids"
      ],
      "type": "object"
    },
    "explicit_non_capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness"
    },
    "kind": {
      "const": "DominiumReadonlySeamBundle"
    },
    "manifest": {
      "additionalProperties": true,
      "required": [
        "bundle_id",
        "bundle_ref",
        "task_id",
        "capability_target",
        "source_revision",
        "schema_version",
        "protocol_version",
        "record_count",
        "selected_file_count",
        "projection_authority",
        "recommended_next_task"
      ],
      "type": "object"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "omission_summary": {
      "additionalProperties": true,
      "required": [
        "omitted_source_files",
        "reason",
        "diagnostic_registry",
        "refusal_registry"
      ],
      "type": "object"
    },
    "records": {
      "additionalProperties": false,
      "properties": {
        "artifact_references": {
          "items": {
            "$ref": "#/$defs/ArtifactReferenceRecord"
          },
          "type": "array"
        },
        "context_descriptor": {
          "$ref": "#/$defs/ContextDescriptorRecord"
        },
        "diagnostic_projections": {
          "items": {
            "$ref": "#/$defs/DiagnosticProjectionRecord"
          },
          "type": "array"
        },
        "dominium_bridge_manifest": {
          "$ref": "#/$defs/DominiumBridgeManifestRecord"
        },
        "event_envelopes": {
          "items": {
            "$ref": "#/$defs/EventEnvelopeRecord"
          },
          "type": "array"
        },
        "evidence_reference_set": {
          "$ref": "#/$defs/EvidenceReferenceSetRecord"
        },
        "host_capability_set": {
          "$ref": "#/$defs/HostCapabilitySetRecord"
        },
        "host_manifest": {
          "$ref": "#/$defs/HostManifestRecord"
        },
        "refusal_projections": {
          "items": {
            "$ref": "#/$defs/RefusalProjectionRecord"
          },
          "type": "array"
        },
        "workspace_descriptor": {
          "$ref": "#/$defs/WorkspaceDescriptorRecord"
        }
      },
      "required": [
        "host_manifest",
        "host_capability_set",
        "workspace_descriptor",
        "context_descriptor",
        "artifact_references",
        "diagnostic_projections",
        "refusal_projections",
        "evidence_reference_set",
        "event_envelopes",
        "dominium_bridge_manifest"
      ],
      "type": "object"
    },
    "registry_projection_summary": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "$ref": "#/$defs/RegistrySummary"
        },
        "refusals": {
          "$ref": "#/$defs/RegistrySummary"
        }
      },
      "required": [
        "diagnostics",
        "refusals"
      ],
      "type": "object"
    },
    "source_snapshot": {
      "additionalProperties": true,
      "properties": {
        "repository_identity": {
          "additionalProperties": true,
          "required": [
            "canonical_identity",
            "host",
            "owner",
            "repository",
            "transport"
          ],
          "type": "object"
        },
        "selected_files": {
          "items": {
            "$ref": "#/$defs/SourceFile"
          },
          "type": "array"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/Digest"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "repository_identity",
        "source_revision",
        "selected_file_count",
        "selected_files",
        "contract_inventory",
        "authority_input_inventory",
        "queue_status",
        "freshness",
        "read_only_operations",
        "snapshot_digest"
      ],
      "type": "object"
    },
    "status": {
      "$ref": "#/$defs/FalseStatus"
    },
    "validation_summary": {
      "additionalProperties": true,
      "required": [
        "validation_status",
        "validated",
        "error_count",
        "warning_count"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "manifest",
    "source_snapshot",
    "records",
    "cross_reference_index",
    "content_digests",
    "authority_classification",
    "freshness",
    "validation_summary",
    "omission_summary",
    "registry_projection_summary",
    "explicit_non_capabilities",
    "status"
  ],
  "title": "AIDE Dominium Read-Only Seam v0",
  "type": "object"
}
