{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aide.dev/schemas/aide-update-plan-v1.schema.json",
  "title": "AIDE UpdatePlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schema_version",
    "metadata",
    "spec",
    "status",
    "extensions"
  ],
  "properties": {
    "apiVersion": {"type": "string", "const": "aide.dev/v1alpha1"},
    "kind": {"type": "string", "const": "UpdatePlan"},
    "schema_version": {"type": "string", "const": "aide.update-plan.v1"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"},
    "status": {"$ref": "#/$defs/status"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "extensions": {"type": "object", "additionalProperties": true},
    "ref": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation_class": {
      "type": "string",
      "enum": [
        "add_managed_file",
        "update_managed_file",
        "remove_managed_file",
        "add_managed_section",
        "update_managed_section",
        "remove_managed_section",
        "preserve_project_owned",
        "preserve_project_overlay",
        "preserve_local_only",
        "preserve_runtime_generated",
        "preserve_evidence_only",
        "preserve_legacy",
        "regenerate_project_output",
        "manual_review_required",
        "refuse"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_plan_ref",
        "target_project_ref",
        "target_project_identity",
        "current_project_lock_ref",
        "current_project_lock_digest",
        "candidate_distribution_ref",
        "candidate_distribution_digest",
        "candidate_project_lock_ref",
        "candidate_project_lock_digest",
        "ownership_ledger_ref",
        "ownership_ledger_digest",
        "created_at",
        "created_by",
        "prior_update_plan_ref",
        "superseded_by_ref",
        "extensions"
      ],
      "properties": {
        "update_plan_ref": {"$ref": "#/$defs/ref"},
        "target_project_ref": {"$ref": "#/$defs/ref"},
        "target_project_identity": {"type": "string", "minLength": 1},
        "current_project_lock_ref": {"$ref": "#/$defs/ref"},
        "current_project_lock_digest": {"$ref": "#/$defs/digest"},
        "candidate_distribution_ref": {"$ref": "#/$defs/ref"},
        "candidate_distribution_digest": {"$ref": "#/$defs/digest"},
        "candidate_project_lock_ref": {"$ref": "#/$defs/ref"},
        "candidate_project_lock_digest": {"$ref": "#/$defs/digest"},
        "ownership_ledger_ref": {"$ref": "#/$defs/ref"},
        "ownership_ledger_digest": {"$ref": "#/$defs/digest"},
        "created_at": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "prior_update_plan_ref": {"type": ["string", "null"]},
        "superseded_by_ref": {"type": ["string", "null"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "operation_ref",
        "operation_class",
        "target_relative_path",
        "ownership_entry_ref",
        "ownership_class",
        "preimage_digest",
        "postimage_digest",
        "rollback_requirement_ref",
        "evidence_refs",
        "source_output_used_as_target_truth",
        "target_repository_mutation_performed",
        "update_apply_implemented",
        "extensions"
      ],
      "properties": {
        "operation_ref": {"$ref": "#/$defs/ref"},
        "operation_class": {"$ref": "#/$defs/operation_class"},
        "target_relative_path": {"type": "string", "minLength": 1},
        "ownership_entry_ref": {"type": ["string", "null"]},
        "ownership_class": {"type": "string", "minLength": 1},
        "owner_ref": {"type": ["string", "null"]},
        "source_distribution_ref": {"type": ["string", "null"]},
        "source_component_ref": {"type": ["string", "null"]},
        "preimage_digest": {"type": "string"},
        "postimage_digest": {"type": "string"},
        "rollback_requirement_ref": {"type": "string"},
        "manual_review_required": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "source_output_used_as_target_truth": {"type": "boolean", "const": false},
        "symlink_reparse_uncertain": {"type": "boolean"},
        "target_repository_mutation_performed": {"type": "boolean", "const": false},
        "update_apply_implemented": {"type": "boolean", "const": false},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install_record_refs",
        "install_record_digests",
        "migration_record_refs",
        "migration_record_digests",
        "planned_operations",
        "preserved_paths",
        "managed_file_updates",
        "managed_section_updates",
        "conflicts",
        "manual_review_items",
        "validation_plan",
        "rollback_requirements",
        "risk_class",
        "approval_requirements",
        "evidence_refs",
        "explicit_non_capabilities",
        "required_features",
        "optional_features",
        "source_output_used_as_target_truth",
        "target_repository_mutation_performed",
        "extensions"
      ],
      "properties": {
        "install_record_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "install_record_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "migration_record_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "migration_record_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "planned_operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "preserved_paths": {"type": "array", "items": {"type": "string"}},
        "managed_file_updates": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "managed_section_updates": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "manual_review_items": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rollback_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "risk_class": {"type": "string", "enum": ["low", "medium", "high", "blocked"]},
        "approval_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "explicit_non_capabilities": {"type": "array", "items": {"type": "string"}},
        "required_features": {"type": "array", "items": {"type": "string"}},
        "optional_features": {"type": "array", "items": {"type": "string"}},
        "source_output_used_as_target_truth": {"type": "boolean", "const": false},
        "target_repository_mutation_performed": {"type": "boolean", "const": false},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "validation_result",
        "proposed_capability",
        "recommended_next_task",
        "update_plan_digest",
        "update_apply_implemented",
        "target_repository_mutation_implemented",
        "extensions"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION"]},
        "validation_result": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION"]},
        "proposed_capability": {"type": "string", "const": "update_plan_v1"},
        "recommended_next_task": {"type": "string", "const": "AIDE-CHECK-UPDATE-PLAN-V1-01"},
        "update_plan_digest": {"$ref": "#/$defs/digest"},
        "install_apply_implemented": {"type": "boolean", "const": false},
        "update_apply_implemented": {"type": "boolean", "const": false},
        "migration_apply_implemented": {"type": "boolean", "const": false},
        "repair_apply_implemented": {"type": "boolean", "const": false},
        "rollback_apply_implemented": {"type": "boolean", "const": false},
        "uninstall_apply_implemented": {"type": "boolean", "const": false},
        "target_repository_mutation_implemented": {"type": "boolean", "const": false},
        "target_scan_authority_implemented": {"type": "boolean", "const": false},
        "release_publication_implemented": {"type": "boolean", "const": false},
        "network_calls_implemented": {"type": "boolean", "const": false},
        "provider_model_calls_implemented": {"type": "boolean", "const": false},
        "workbench_runtime_implemented": {"type": "boolean", "const": false},
        "commander_implemented": {"type": "boolean", "const": false},
        "omnigent_implemented": {"type": "boolean", "const": false},
        "branch_worktree_automation_implemented": {"type": "boolean", "const": false},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    }
  }
}
