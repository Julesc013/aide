{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDE Scoped Transaction Plan v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "transaction_id",
    "mode",
    "allowed_roots",
    "protected_roots",
    "allowed_operation_types",
    "operations",
    "report_path",
    "rollback_record_path"
  ],
  "properties": {
    "schema_version": {
      "const": "aide.scoped-transaction-plan.v0"
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "dry-run",
        "dry_run",
        "report",
        "apply"
      ]
    },
    "allowed_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_operation_types": {
      "type": "array",
      "items": {
        "enum": [
          "update_managed_section",
          "report",
          "validate",
          "noop"
        ]
      }
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "rollback_record_path": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "operation_id",
          "operation_type"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "operation_type": {
            "enum": [
              "update_managed_section",
              "report",
              "validate",
              "noop"
            ]
          },
          "path": {
            "type": "string"
          },
          "section_name": {
            "type": "string"
          },
          "replacement_content": {
            "type": "string"
          },
          "expected_preimage_hash": {
            "type": "string"
          },
          "expected_postimage_hash": {
            "type": "string"
          }
        }
      }
    }
  }
}
