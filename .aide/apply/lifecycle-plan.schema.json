{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDE Lifecycle Plan v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "lifecycle_plan_id",
    "phase",
    "mode",
    "fixture_only",
    "source_manifest_ref",
    "explicit_operations",
    "operation_allowlist",
    "explicit_paths",
    "allowed_roots",
    "protected_roots",
    "preimage_hash_requirements",
    "postimage_hash_requirements",
    "rollback_record_destination",
    "evidence_report_destination",
    "stop_conditions",
    "review_gate",
    "prohibited_operation_checks"
  ],
  "properties": {
    "schema_version": {"const": "aide.lifecycle-plan.v0"},
    "lifecycle_plan_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["install", "upgrade", "repair", "rollback", "uninstall"]},
    "mode": {"enum": ["report", "dry-run", "fixture-apply", "active-repo-apply", "target-apply"]},
    "fixture_only": {"type": "boolean"},
    "source_manifest_ref": {"type": "string", "minLength": 1},
    "target_fixture_root": {"type": "string"},
    "explicit_operations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "operation_allowlist": {"type": "array", "items": {"type": "string"}},
    "explicit_paths": {"type": "array", "items": {"type": "string"}},
    "allowed_roots": {"type": "array", "items": {"type": "string"}},
    "protected_roots": {"type": "array", "items": {"type": "string"}},
    "preimage_hash_requirements": {"type": "array", "items": {"type": "object"}},
    "postimage_hash_requirements": {"type": "array", "items": {"type": "object"}},
    "rollback_record_destination": {"type": "string"},
    "evidence_report_destination": {"type": "string"},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "review_gate": {"const": "needs_review"},
    "prohibited_operation_checks": {"type": "array", "items": {"type": "string"}},
    "target_files_mutated_expected": {"type": "boolean"}
  }
}
