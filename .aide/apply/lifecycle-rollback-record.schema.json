{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDE Rollback-Compatible Lifecycle Record v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "lifecycle_plan_id",
    "transaction_or_operation_ids",
    "lifecycle_phase",
    "target_class",
    "path",
    "operation_type",
    "ownership_type",
    "preimage_hash",
    "postimage_hash",
    "inverse_operation",
    "rollback_preconditions",
    "rollback_stop_conditions",
    "evidence_refs",
    "review_gate",
    "rollback_execution_implemented"
  ],
  "properties": {
    "schema_version": {"const": "aide.lifecycle-rollback-record.v0"},
    "record_id": {"type": "string"},
    "lifecycle_plan_id": {"type": "string"},
    "transaction_or_operation_ids": {"type": "array", "items": {"type": "string"}},
    "lifecycle_phase": {"enum": ["install", "upgrade", "repair", "rollback", "uninstall"]},
    "target_class": {"enum": ["fixture", "active-aide-repo", "target-repo"]},
    "path": {"type": "string"},
    "operation_type": {"type": "string"},
    "ownership_type": {"enum": ["generated-file", "managed-section", "metadata", "report", "unknown/disallowed"]},
    "preimage_hash": {"type": "string"},
    "preimage_content_ref": {"type": "string"},
    "postimage_hash": {"type": "string"},
    "postimage_content_ref": {"type": "string"},
    "inverse_operation": {"type": "object"},
    "rollback_preconditions": {"type": "array", "items": {"type": "string"}},
    "rollback_stop_conditions": {"type": "array", "items": {"type": "string"}},
    "manual_content_preservation_notes": {"type": "array", "items": {"type": "string"}},
    "protected_path_checks": {"type": "array", "items": {"type": "string"}},
    "validation_requirements_before_rollback": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "review_gate": {"const": "needs_review"},
    "unsupported_rollback_reasons": {"type": "array", "items": {"type": "string"}},
    "rollback_execution_implemented": {"const": false}
  }
}
