{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDE Lifecycle Report v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_id",
    "lifecycle_plan_id",
    "lifecycle_phase",
    "mode",
    "status",
    "target_class",
    "target_files_mutated",
    "operations",
    "validation_results",
    "evidence_paths",
    "review_gate",
    "capability_label"
  ],
  "properties": {
    "schema_version": {"const": "aide.lifecycle-report.v0"},
    "report_id": {"type": "string"},
    "lifecycle_plan_id": {"type": "string"},
    "lifecycle_phase": {"enum": ["install", "upgrade", "repair", "rollback", "uninstall"]},
    "mode": {"enum": ["report", "dry-run", "fixture-apply", "active-repo-apply", "target-apply"]},
    "status": {"enum": ["PASS", "PASS_WITH_WARNINGS", "FAILED_VALIDATION", "BLOCKED", "NEEDS_REVIEW"]},
    "blocked_reason": {"type": "string"},
    "target_class": {"enum": ["fixture", "active-aide-repo", "target-repo"]},
    "target_path_summary": {"type": "array", "items": {"type": "string"}},
    "operations": {"type": "array", "items": {"type": "object"}},
    "files_that_would_change": {"type": "array", "items": {"type": "string"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "target_files_mutated": {"type": "boolean"},
    "preimage_hashes": {"type": "array", "items": {"type": "object"}},
    "postimage_hashes": {"type": "array", "items": {"type": "object"}},
    "rollback_compatible_record_refs": {"type": "array", "items": {"type": "string"}},
    "validation_results": {"type": "array", "items": {"type": "object"}},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "unresolved_risks": {"type": "array", "items": {"type": "string"}},
    "review_gate": {"const": "needs_review"},
    "capability_label": {"type": "string"}
  }
}
