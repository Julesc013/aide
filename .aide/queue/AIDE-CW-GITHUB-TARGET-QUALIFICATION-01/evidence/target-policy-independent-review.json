  "findings": [
    {
      "id": "F-03",
      "priority": "P1",
      "status": "OPEN",
      "title": "Documented workflow-run paths cannot enter qualification",
      "evidence": "GitHub's workflow-run documentation shows .github/workflows/file.yml@ref, and the exact 2026-03-10 OpenAPI workflow-run component marks path required with octocat/octo-repo/.github/workflows/ci.yml@main as its example. github_checks.py permits only the relative syntax in its regex and then compares the entire raw value to a plan field restricted to a bare path. The committed fixture uses only a bare path. Independent relative path@ref and repository-prefixed example-shape probes were refused as source mismatches.",
      "impact": "The implementation fails closed before a GitHub Actions response having the documented shape can reach normalized observation, durable decision/intent, or bridge qualification. Passing fixtures therefore do not qualify that API shape.",
      "required_change": "Parse and validate path@ref, bind the path and source selector to admitted branch/head semantics, retain an unambiguous accepted representation through observation/decision/intent/bridge, and add official-shape positive and wrong/missing/malformed-ref tests.",
      "locations": [
        "core/runtime/integration_broker/github_checks.py:53",
        "core/runtime/integration_broker/github_checks.py:56",
        "core/runtime/integration_broker/pr_observation.py:34",
        "core/runtime/integration_broker/pr_observation.py:89",
        ".aide/scripts/tests/test_continuous_worker_github_observation.py:118"
      ],
      "official_docs": [
        "https://docs.github.com/en/rest/actions/workflow-runs",
        "https://github.com/github/rest-api-description/blob/main/descriptions/api.github.com/api.github.com.2026-03-10.json",
        "https://docs.github.com/en/rest/actions/workflow-jobs",
        "https://docs.github.com/en/rest/checks/runs"
      ]
    },
